# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# brainstorming companion artifacts
/.superpowers/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documents clients non publiables
# Les plans de assets-sources/ portent des cartouches nominatifs (maîtres d'ouvrage identifiés,
# adresses precises) et ne doivent quitter ni le poste de travail ni le web root.
# Retirer cette ligne uniquement apres accord ecrit des maitres d'ouvrage concernes.
/assets-sources/
